---
import { pipeline } from "../lib/data";
---

<section class="band">
	<div class="wrap">
		<h2>The pipeline, end to end</h2>
		<div class="steps">
			{
				pipeline.map((name, i) => (
					<div class="step">
						<span class="pill">{name}</span>
						{i < pipeline.length - 1 && <span class="sep">→</span>}
					</div>
				))
			}
		</div>
		<p class="note">
			A default path, not a prison — backtrack deliberately when assumptions
			fail.
		</p>
	</div>
</section>

<style>
	.band {
		background: var(--gold);
		color: var(--ink-bg);
	}
	.band .wrap {
		padding-block: 72px;
	}
	.band h2 {
		font-family: var(--display);
		font-weight: 500;
		font-size: 38px;
		margin: 0 0 36px;
		text-align: center;
	}
	.steps {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 10px 0;
		font-size: 15.5px;
		font-weight: 600;
	}
	.step {
		display: flex;
		align-items: center;
	}
	.pill {
		border: 1.5px solid var(--ink-bg);
		border-radius: 2px;
		padding: 9px 16px;
		white-space: nowrap;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.pill:hover {
		background: var(--ink-bg);
		color: var(--gold);
	}
	.sep {
		padding: 0 8px;
	}
	.note {
		text-align: center;
		font-size: 14.5px;
		margin: 30px 0 0;
		opacity: 0.75;
		font-style: italic;
	}
</style>
