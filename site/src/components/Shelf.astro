---
import { canon, type CanonWork } from "../lib/canon.generated";

// EVERY DECLARED WORK, NOT A CURATED SUBSET (issue #273). The array below is
// generated from `sources:` frontmatter, so this component must render all of
// it — slicing here would put the page back to hiding a curation decision the
// reader cannot see, which is the defect the derivation exists to remove.
// `scripts/test-canon-coverage.sh` fails if this file slices or filters it.

/** Breadth of reuse: how many skills name this work at all. */
const weightOf = (w: CanonWork) => w.citations.length;

/**
 * Core lineage: how many skills name it as a work they are *built on*.
 * CLAUDE.md defines the two tiers — `primary` is "core lineage — the skill is
 * fundamentally built on this work", `secondary` is a supporting influence.
 */
const lineageOf = (w: CanonWork) =>
	w.citations.reduce((n, c) => n + (c.tier === "primary" ? 1 : 0), 0);

// TWO SIGNALS, TWO CHANNELS (issue #274). Height already carried breadth, and
// #274 named the trade that left open: breadth is not centrality, and a bookcase
// ranked by breadth alone buried the four books the pipeline is most
// recognizably built on — *TDD By Example* sat 37th of 45, *Shape Up* 19th,
// *Refactoring* 18th, *Domain-Driven Design* 17th, while works no skill calls
// core lineage led the top board. So the ORDER is core lineage and the HEIGHT
// stays breadth: two different claims, each read off the frontmatter, neither
// standing in for the other.
//
// The other option #274 weighed was a hand-ordered top board. It was rejected
// for the reason the whole batch exists: a hand-ordered list of flagships is a
// second hand-maintained canon, and it would drift out of step with the skills
// exactly the way the eight-spine shelf did.
//
// CODE-UNIT COMPARISON, NOT `localeCompare`. The tie-break has to be
// reproducible off the machine that built the page: whether ICU treats the
// hyphen in "Domain-Driven Design" as ignorable decides three spines' order, and
// `scripts/test-canon-coverage.sh` asserts this exact sequence against a shell
// `LC_ALL=C sort`. Comparing code units is what makes the two agree by
// construction rather than by luck of the runtime's collation data.
const spines = [...canon].sort(
	(a, b) =>
		lineageOf(b) - lineageOf(a) ||
		weightOf(b) - weightOf(a) ||
		(a.full < b.full ? -1 : a.full > b.full ? 1 : 0),
);

// A HEIGHT BAND PER OBJECT TYPE. #274: "Books and papers are different objects.
// Whatever form the section takes should be able to render both without
// pretending the papers are books." A bound volume and a stapled offprint do not
// share a height, so they do not share a scale — the paper band sits entirely
// below the book band, and each type's weight is read against its own peers so
// breadth still shows *within* a type.
const BANDS = {
	book: { min: 214, max: 356 },
	paper: { min: 122, max: 168 },
} as const;

// Per-type weight extents, accumulated in a loop rather than with
// `canon.filter(...)`: the contract suite's narrowing tripwire greps this file
// for `canon` followed by a narrowing call, and it is right to — a reader
// skimming for "does this component drop entries" should not have to tell an
// extent from a filter.
const extents: Record<CanonWork["type"], { lo: number; hi: number }> = {
	book: { lo: Infinity, hi: 0 },
	paper: { lo: Infinity, hi: 0 },
};
for (const w of canon) {
	const e = extents[w.type];
	e.lo = Math.min(e.lo, weightOf(w));
	e.hi = Math.max(e.hi, weightOf(w));
}

function heightOf(w: CanonWork): number {
	const { lo, hi } = extents[w.type];
	const band = BANDS[w.type];
	const span = hi - lo;
	const t = span <= 0 ? 1 : (weightOf(w) - lo) / span;
	return Math.round(band.min + t * (band.max - band.min));
}

// A fixed palette, assigned by a stable hash of the declared string. Forty-five
// spines cannot be hand-tinted, and a hash keeps a work's color from shifting
// every time an unrelated skill adds a source.
const PALETTE = [
	{ color: "#7A3B2E", ink: "#F0E9D8" },
	{ color: "#31536B", ink: "#F0E9D8" },
	{ color: "#6B5B2E", ink: "#F0E9D8" },
	{ color: "#3E5C46", ink: "#F0E9D8" },
	{ color: "#54364F", ink: "#F0E9D8" },
	{ color: "#2E4A52", ink: "#F0E9D8" },
	{ color: "#8A6A32", ink: "#1C2822" },
	{ color: "#2F4238", ink: "#F0E9D8" },
];

function paletteOf(full: string) {
	let h = 0;
	for (let i = 0; i < full.length; i++) h = (h * 31 + full.charCodeAt(i)) >>> 0;
	return PALETTE[h % PALETTE.length];
}

/**
 * The inline style for one spine. Height is per work, so it is emitted here;
 * the offprint's surface is one rule for all papers, so it is not.
 *
 * A PAPER GETS NO INLINE COLOR ON PURPOSE. An inline `background` would win over
 * the stylesheet, so the offprint could not be given its own manila stock and
 * stapled edge without repeating them per element. Leaving the paper's surface
 * to CSS is also what keeps the two definitions of "different object" from
 * splitting: the height reaches the HTML where the contract suite can grade it,
 * and everything else is one selector a reader can find in one place.
 */
function styleOf(w: CanonWork, i: number): string {
	const base = `--i:${Math.min(i, 24)}; height:${heightOf(w)}px;`;
	if (w.type === "paper") return base;
	const { color, ink } = paletteOf(w.full);
	return `${base} background:${color}; color:${ink};`;
}

/**
 * What the edge of the object actually shows. A bound spine carries its title;
 * an offprint's stapled edge does not, and the two papers here have 65- and
 * 78-character titles that no 168px edge can hold. So a paper shows its citation
 * — "Liang et al. (EMNLP 2024)" — which is how a paper is referred to anyway.
 * The full string is on the tooltip and on the opened spread either way.
 */
const edgeLabel = (w: CanonWork) => (w.type === "paper" ? w.author : w.title);
---

<section id="canon" class="canon">
	<div class="wrap">
		<div class="head">
			<div class="eyebrow">The canon</div>
			<h2>The shelf behind the skills</h2>
		</div>

		<div class="shelf" data-shelf>
			{
				spines.map((w, i) => (
					<button
						type="button"
						class="spine"
						style={styleOf(w, i)}
						title={`${w.full} — cited by ${w.citations.length} skill${w.citations.length === 1 ? "" : "s"}`}
						aria-pressed="false"
						data-key={w.full}
						data-type={w.type}
					>
						<span class="label">{edgeLabel(w)}</span>
					</button>
				))
			}
		</div>
		<div class="detail-slot" data-detail></div>

		<p class="hint" data-hint>
			Pull a book off the shelf — all {canon.length} works the skills cite,
			ordered by how many are built on them and taller where more of them cite
			it. Each SKILL.md names its sources in frontmatter.
		</p>
	</div>
</section>

<style>
	.canon {
		border-top: 1px solid var(--rule);
		background: var(--ink-bg-deep);
	}
	.canon .wrap {
		padding-block: 92px;
	}
	.head {
		text-align: center;
		margin-bottom: 56px;
	}
	.head .eyebrow {
		margin-bottom: 14px;
	}
	.head h2 {
		font-family: var(--display);
		font-weight: 500;
		font-size: 44px;
		margin: 0;
	}

	/* THE BOARD IS DRAWN PER SPINE, WHICH IS WHAT LETS A ROW BE ITS OWN HEIGHT.
	   #273 wrapped the row and painted the board as a repeating background at a
	   fixed pitch, which is the only way to hit every implicit row when they are
	   all the same height — and it forced every row to reserve the height of the
	   tallest spine in the whole canon. Rows two through four topped out at 229px
	   inside a 400px band, so the section carried ~430px of void and read as four
	   shelves floating in the dark. Its own comment called that a minimum repair
	   and handed the form to this issue.

	   Each spine now paints the plank under itself, bleeding half a gutter to
	   either side so neighbouring segments meet with no seam, and the grid rows
	   size to their content. The last row's plank stops at the last book, which
	   is the honest picture: the case is not full. */
	.shelf {
		--board-h: 13px;
		--col-w: 84px;
		--gutter: 10px;

		display: grid;
		grid-template-columns: repeat(auto-fit, var(--col-w));
		grid-auto-rows: auto;
		align-items: end;
		justify-items: center;
		justify-content: center;
		row-gap: 34px;
	}

	.spine {
		position: relative;
		/* Declared as a variable because the plank below has to span the whole
		   COLUMN, not the object standing on it — and an offprint is much
		   narrower than a book. Reading the width off a custom property is what
		   lets one rule size both. */
		--spine-w: calc(var(--col-w) - var(--gutter));
		width: var(--spine-w);
		margin-bottom: var(--board-h);
		/* NO `overflow: hidden` HERE. It used to do the label's clipping, and it
		   also clipped the plank below — a pseudo-element at `top: 100%` is still
		   a child. The label now owns its own overflow (see `.label`), which is
		   where the constraint belongs anyway. */
		border: none;
		border-radius: 3px 3px 0 0;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: 14px 4px;
		cursor: pointer;
		box-shadow:
			inset -6px 0 10px rgba(0, 0, 0, 0.28),
			inset 2px 0 0 rgba(255, 255, 255, 0.12);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
		font: inherit;
	}
	/* The plank. `overflow: hidden` on .spine clips its own children, so this
	   sits on a wrapper-free pseudo-element anchored below the spine's box. */
	.spine::after {
		content: "";
		position: absolute;
		/* Bleed out to the column's edges — half the empty space on each side —
		   so neighbouring segments meet exactly and read as one plank. Anchoring
		   to the gutter instead would size the segment to the spine, which is
		   right for a 74px book and leaves a 28px hole under a 46px offprint. */
		inset-inline: calc((var(--col-w) - var(--spine-w)) / -2);
		top: 100%;
		height: var(--board-h);
		background: linear-gradient(180deg, #5c4a2e 0%, #3e3120 100%);
		box-shadow: 0 3px 7px rgba(0, 0, 0, 0.42);
		/* Same easing as the spine, so the two stay in lockstep for the whole
		   pull rather than only at the ends of it. */
		transition: transform 0.25s ease;
	}
	.spine:hover {
		transform: translateY(-10px);
	}
	/* The plank does not move with the book that was pulled off it: the spine's
	   transform carries the pseudo-element along, and this puts it back. */
	.spine:hover::after,
	.spine[aria-pressed="true"]::after {
		transform: translateY(10px);
	}
	.spine .label {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		font-family: var(--display);
		font-size: 14.5px;
		letter-spacing: 0.04em;
		line-height: 1.22;
		text-align: center;
		/* WRAP RATHER THAN CLIP. `white-space: nowrap` put the longest titles —
		   "Growing Object-Oriented Software, Guided by Tests" at 48 characters —
		   off the top of the spine mid-word, with no ellipsis, because
		   `text-overflow` does not apply to a vertical overflow. Two vertical
		   lines hold every title in the canon and read like a real spine.

		   IN `vertical-rl` THE AXES SWAP: the INLINE axis runs down the spine and
		   the BLOCK axis runs across it. So `max-inline-size` is what caps the
		   title's run and makes it wrap, and `max-block-size` is what keeps the
		   wrapped lines inside the spine's width. Both, or the wrap depends on
		   the flex container's incidental sizing. */
		max-inline-size: 100%;
		max-block-size: 100%;
		overflow: hidden;
	}

	/* ── The offprint ──────────────────────────────────────────────
	   Issue #274: books and papers are different objects, and the section has to
	   render both without pretending the papers are books. A conference paper is
	   not a bound volume — it is a slim stapled offprint, so it is narrower, on
	   plain manila stock rather than dyed cloth, square-cornered, flat instead of
	   rounded under a cloth shadow, and stapled twice down its edge. Its height
	   comes from its own band (see BANDS above), which puts every offprint below
	   every book on the board. */
	.spine[data-type="paper"] {
		--spine-w: 46px;
		border-radius: 0;
		background: linear-gradient(94deg, #cdc3a6 0%, #bdb193 100%);
		color: #3a3524;
		padding: 12px 3px;
		box-shadow:
			inset -2px 0 5px rgba(0, 0, 0, 0.16),
			inset 0 0 0 1px rgba(58, 53, 36, 0.28);
	}
	/* Two staples down the bound edge. */
	.spine[data-type="paper"]::before {
		content: "";
		position: absolute;
		left: 6px;
		top: 22%;
		bottom: 22%;
		width: 2px;
		background:
			linear-gradient(#6d6650 0 9px, transparent 9px) top / 2px 100% no-repeat,
			linear-gradient(#6d6650 0 9px, transparent 9px) bottom / 2px 9px no-repeat;
	}
	.spine[data-type="paper"] .label {
		font-family: var(--mono);
		font-size: 10.5px;
		letter-spacing: 0.01em;
	}

	/* Scroll-reveal: hide only when JS can bring them back. */
	:global(.has-js) .shelf .spine {
		opacity: 0;
	}
	:global(.has-js) .shelf[data-revealed] .spine {
		animation: spineRise 0.6s cubic-bezier(0.22, 1, 0.36, 1)
			calc(var(--i) * 0.09s) both;
	}

	.spine[aria-pressed="true"] {
		transform: translateY(-10px);
		box-shadow:
			inset -6px 0 10px rgba(0, 0, 0, 0.28),
			inset 2px 0 0 rgba(255, 255, 255, 0.12),
			0 0 0 2px var(--gold);
	}

	.hint {
		text-align: center;
		color: var(--muted);
		font-size: 14.5px;
		font-style: italic;
		margin: 36px auto 0;
		max-width: 560px;
	}

	/* ── Open book ─────────────────────────────────────────────── */
	.detail-slot :global(.book) {
		max-width: 920px;
		margin: 44px auto 0;
		perspective: 1600px;
		animation: bookArrive 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	.detail-slot :global(.spread) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-radius: 4px 10px 10px 4px;
		box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5);
		position: relative;
		transform-style: preserve-3d;
	}
	.detail-slot :global(.page) {
		color: #2a2a22;
		padding: 42px 38px 46px;
	}
	.detail-slot :global(.page-left) {
		background: linear-gradient(100deg, #ede4ce 88%, #ddd2b6 100%);
		border-radius: 4px 0 0 4px;
		border-right: 1px solid #c9bc9e;
		box-shadow: inset -18px 0 24px -14px rgba(0, 0, 0, 0.28);
	}
	.detail-slot :global(.page-right) {
		background: linear-gradient(260deg, #f2ebda 88%, #e2d8be 100%);
		border-radius: 0 10px 10px 0;
		box-shadow: inset 18px 0 24px -14px rgba(0, 0, 0, 0.22);
		transform-origin: left center;
		animation: pageOpen 0.85s cubic-bezier(0.25, 0.9, 0.3, 1) 0.2s both;
		backface-visibility: hidden;
	}
	.detail-slot :global(.page-right-inner) {
		animation: inkFade 0.5s ease 0.75s both;
	}
	.detail-slot :global(.plabel) {
		font-size: 11px;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: #8a7b54;
		margin-bottom: 22px;
	}
	.detail-slot :global(.ptitle) {
		font-family: var(--display);
		font-size: 30px;
		line-height: 1.12;
		margin-bottom: 6px;
	}
	.detail-slot :global(.pauthor) {
		font-family: var(--display);
		font-style: italic;
		font-size: 16px;
		color: #6e6448;
		margin-bottom: 26px;
	}
	.detail-slot :global(.plesson) {
		font-family: var(--display);
		font-style: italic;
		font-size: 20px;
		line-height: 1.45;
		color: #3e3a2c;
		border-top: 1px solid #c9bc9e;
		padding-top: 22px;
	}
	.detail-slot :global(.pprovenance) {
		font-size: 13.5px;
		letter-spacing: 0.02em;
		color: #6e6448;
		border-top: 1px solid #c9bc9e;
		padding-top: 20px;
	}
	/* The lesson is optional, so its spacing cannot assume it is present. */
	.detail-slot :global(.pprovenance + .plesson) {
		border-top: none;
		padding-top: 20px;
	}
	.detail-slot :global(.pcites) {
		list-style: none;
		margin: 0 0 26px;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 14px;
	}
	.detail-slot :global(.pcite) {
		display: inline-flex;
		align-items: baseline;
		gap: 7px;
		font-size: 14px;
	}
	.detail-slot :global(.ptier) {
		font-family: var(--mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #8a7b54;
	}
	.detail-slot :global(.ptier-primary) {
		color: #7a5c1e;
		font-weight: 600;
	}
	.detail-slot :global(.pfmlabel) {
		font-size: 11px;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: #8a7b54;
		margin-bottom: 12px;
	}
	.detail-slot :global(.pfm) {
		font-family: var(--mono);
		font-size: 12.5px;
		line-height: 1.6;
		background: #e7dcbf;
		border: 1px solid #d3c6a2;
		border-radius: 4px;
		padding: 14px 16px;
		margin: 0 0 20px;
		white-space: pre-wrap;
		color: #4a432e;
	}
	.detail-slot :global(.plink) {
		font-size: 13.5px;
		font-weight: 600;
		color: #7a5c1e;
		border-bottom: 1px solid #c9bc9e;
		padding-bottom: 2px;
	}
	.detail-slot :global(.plink:hover) {
		color: #a4552f;
		text-decoration: none;
	}

	@media (max-width: 720px) {
		.detail-slot :global(.spread) {
			grid-template-columns: 1fr;
		}
		.detail-slot :global(.page-left) {
			border-radius: 4px 4px 0 0;
			border-right: none;
			border-bottom: 1px solid #c9bc9e;
			box-shadow: none;
		}
		.detail-slot :global(.page-right) {
			border-radius: 0 0 10px 10px;
			box-shadow: none;
			animation: inkFade 0.5s ease both;
		}
	}

	/* One scrollable row on narrow screens, rather than 45 spines wrapping into
	   a column two books wide. The board rides along as the background of the
	   scrolled track. */
	@media (max-width: 680px) {
		.shelf {
			--col-w: 70px;
			grid-auto-flow: column;
			grid-auto-columns: var(--col-w);
			grid-template-columns: none;
			justify-content: start;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: thin;
			/* One row, so the planks form a single continuous board that scrolls
			   with the books standing on it. */
			padding-bottom: var(--board-h);
		}
		.spine .label {
			font-size: 13px;
		}
	}
</style>

<script>
	import { canon, type CanonWork } from "../lib/canon.generated";
	import { lessons, repoUrl } from "../lib/data";

	const byKey = new Map<string, CanonWork>(canon.map((w) => [w.full, w]));

	const shelf = document.querySelector<HTMLElement>("[data-shelf]");
	const slot = document.querySelector<HTMLElement>("[data-detail]");
	const hint = document.querySelector<HTMLElement>("[data-hint]");
	const spines = Array.from(
		shelf?.querySelectorAll<HTMLButtonElement>(".spine") ?? [],
	);

	const RESTING_HINT =
		"Pull a book off the shelf — each SKILL.md names its sources in frontmatter.";

	let selectedKey: string | null = null;

	function el(tag: string, cls: string, text?: string) {
		const node = document.createElement(tag);
		node.className = cls;
		if (text !== undefined) node.textContent = text;
		return node;
	}

	/** "Cited by 9 skills — 1 primary, 8 secondary", read off the citations. */
	function provenanceLine(work: CanonWork): string {
		const primary = work.citations.filter((c) => c.tier === "primary").length;
		const secondary = work.citations.length - primary;
		const parts: string[] = [];
		if (primary) parts.push(`${primary} primary`);
		if (secondary) parts.push(`${secondary} secondary`);
		const noun = work.citations.length === 1 ? "skill" : "skills";
		return `Cited by ${work.citations.length} ${noun} — ${parts.join(", ")}`;
	}

	/**
	 * The `sources:` entry as the citing skill declares it. Derived from the
	 * canon rather than transcribed from the file — a hand-copied excerpt is what
	 * issue #273 removed, and a transcription can go stale the moment the skill
	 * is re-sourced.
	 */
	function sourcesSnippet(work: CanonWork, tier: string): string {
		return `sources:\n  ${tier}:\n    - "${work.full}"`;
	}

	function renderDetail(spine: HTMLButtonElement) {
		const key = spine.dataset.key ?? "";
		const work = byKey.get(key);
		if (!slot || !work) return;

		const book = el("div", "book");
		const spread = el("div", "spread");

		const left = el("div", "page page-left");
		left.append(
			el("div", "plabel", work.type === "paper" ? "From the paper" : "From the book"),
			el("div", "ptitle", work.title),
			el("div", "pauthor", work.author),
			el("div", "pprovenance", provenanceLine(work)),
		);
		// Optional enrichment: most works have no hand-written lesson, and the
		// spread has to read well without one.
		const lesson = lessons[work.full];
		if (lesson) left.append(el("div", "plesson", lesson));

		const right = el("div", "page page-right");
		const inner = el("div", "page-right-inner");
		inner.append(el("div", "plabel", "Into the skills"));

		const list = el("ul", "pcites");
		for (const cite of work.citations) {
			const row = el("li", "pcite");
			const link = document.createElement("a");
			link.className = "plink";
			link.href = `${repoUrl}/blob/prod/${cite.skill}/SKILL.md`;
			link.target = "_blank";
			link.rel = "noopener";
			link.textContent = `/${cite.skill}`;
			row.append(link, el("span", `ptier ptier-${cite.tier}`, cite.tier));
			list.append(row);
		}
		inner.append(list);

		const first = work.citations[0];
		if (first) {
			inner.append(
				el("div", "pfmlabel", `As ${`/${first.skill}`} declares it`),
				el("pre", "pfm", sourcesSnippet(work, first.tier)),
			);
		}
		right.append(inner);

		spread.append(left, right);
		book.append(spread);

		slot.replaceChildren(book);
	}

	function select(spine: HTMLButtonElement) {
		const key = spine.dataset.key ?? "";
		if (key === selectedKey) {
			close();
			return;
		}
		selectedKey = key;
		for (const s of spines)
			s.setAttribute("aria-pressed", String(s === spine));
		renderDetail(spine);
		if (hint) hint.textContent = "Click the spine again to close the book.";
	}

	function close() {
		selectedKey = null;
		for (const s of spines) s.setAttribute("aria-pressed", "false");
		slot?.replaceChildren();
		if (hint) hint.textContent = RESTING_HINT;
	}

	for (const spine of spines) {
		spine.addEventListener("click", () => select(spine));
	}

	// Reveal spines on first scroll into view, then auto-open the flagship.
	if (shelf) {
		const io = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					io.disconnect();
					shelf.setAttribute("data-revealed", "");
					window.setTimeout(() => {
						if (!selectedKey && spines[0]) select(spines[0]);
					}, 1400);
				}
			},
			{ threshold: 0.35 },
		);
		io.observe(shelf);
	}
</script>
