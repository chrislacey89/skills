---
import { repoUrl, installCommand, fullInstallCommand } from "../lib/data";
import { canon } from "../lib/canon.generated";

// The book count is derived, not written. It read "Eight books" until #273 —
// correct when the shelf was a hand-picked eight, and quietly wrong from the
// moment the canon started coming from `sources:` frontmatter. This is the one
// line on the page that advertises the section, so a stale number here is the
// drift #273 closed, surviving in the copy that points at it.
// `scripts/test-canon-coverage.sh` compares this against the canon in the
// BUILT page, so the derivation cannot be undone without a check going red.
//
// AND IT COUNTS THE TWO OBJECT TYPES SEPARATELY (issue #274). Deriving the
// number fixed only half of it: the line went on saying "45 books" while three
// of the forty-five were conference papers, so the page's own headline called a
// paper a book — the thing #274 asked the section below to stop doing. The
// papers clause is conditional because a canon with no papers should not
// advertise "0 papers"; the contract suite grades each count against its own
// population and their sum against the whole canon.
const books = canon.filter((w) => w.type === "book").length;
const papers = canon.length - books;
---

<header class="hero wrap">
	{/* ONE SOURCE LINE, DELIBERATELY. The suite's reader is line-based; breaking
	    this element across lines puts a newline between the marker and the counts
	    and the reader comes back empty, which reports as "the eyebrow no longer
	    advertises a count".

	    `data-canon-counts` IS THE READER'S ANCHOR, and it is here rather than in
	    the suite because four elements on this page carry `class="eyebrow"` — the
	    hero's, and the section headers for the canon, the practice table, and the
	    collection. Anchoring on the class meant "the first eyebrow that mentions
	    the noun", which is the hero only by accident of document order. The
	    section header most likely to gain a count is the canon's, which is the
	    heading of the very thing being graded. */}
	<div class="eyebrow" data-canon-counts>Thirty skills · {books} books{papers > 0 ? ` · ${papers} papers` : ""} · One pipeline</div>
	<h1>Fifty years of software wisdom, <em>finally executable.</em></h1>
	<p class="sub">
		Install a delivery pipeline your coding agent actually follows — shape,
		build, test, review, ship. Every stage operationalizes a proven
		engineering discipline, and every skill cites its source. Nothing rests on
		vibes.
	</p>
	<div class="cta-row">
		<a class="btn-primary" href={`${repoUrl}#installation`}>Install the pack</a>
		<a class="btn-ghost" href="#canon">Browse the shelf</a>
	</div>

	<button
		type="button"
		class="copybox"
		data-copy={fullInstallCommand}
		aria-label="Copy install command to clipboard"
	>
		<span class="prompt" aria-hidden="true">$</span>
		<span class="cmd">{installCommand}</span>
		<span class="copylabel" data-copylabel>copy</span>
	</button>
</header>

<style>
	.hero {
		padding-block: 100px 84px;
		text-align: center;
	}
	.eyebrow {
		margin-bottom: 30px;
	}
	h1 {
		font-family: var(--display);
		font-weight: 500;
		font-size: clamp(52px, 7vw, 100px);
		line-height: 1.04;
		letter-spacing: -0.01em;
		margin: 0 auto 30px;
		max-width: 940px;
	}
	h1 em {
		color: var(--gold);
		font-style: italic;
	}
	.sub {
		font-size: 19px;
		color: var(--sage);
		max-width: 640px;
		margin: 0 auto 44px;
		text-wrap: pretty;
	}
	.cta-row {
		display: flex;
		justify-content: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 34px;
	}
	.btn-primary,
	.btn-ghost {
		padding: 15px 32px;
		border-radius: 2px;
		font-size: 15px;
	}
	.btn-primary {
		background: var(--gold);
		color: var(--ink-bg);
		font-weight: 600;
	}
	.btn-primary:hover {
		background: var(--gold-bright);
		text-decoration: none;
	}
	.btn-ghost {
		border: 1px solid var(--rule-soft);
		color: var(--paper);
		font-weight: 500;
	}
	.btn-ghost:hover {
		border-color: var(--gold);
		text-decoration: none;
	}
	.copybox {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		border: 1px solid var(--rule);
		background: var(--ink-bg-deep);
		border-radius: 2px;
		padding: 13px 20px;
		font-family: var(--mono);
		font-size: 13.5px;
		color: var(--sage);
		cursor: pointer;
	}
	.copybox:hover {
		border-color: var(--gold);
	}
	.prompt {
		color: var(--rule-soft);
		user-select: none;
	}
	.cmd {
		white-space: nowrap;
	}
	.copylabel {
		color: var(--gold);
		font-size: 12px;
		min-width: 56px;
		text-align: right;
	}
	@media (max-width: 560px) {
		.hero {
			padding-block: 64px 60px;
		}
		h1 {
			font-size: clamp(40px, 12vw, 62px);
		}
		.copybox {
			max-width: 100%;
		}
		.cmd {
			white-space: normal;
			word-break: break-word;
			text-align: left;
		}
	}
</style>

<script>
	const box = document.querySelector<HTMLButtonElement>(".copybox");
	const label = box?.querySelector<HTMLElement>("[data-copylabel]");
	let resetTimer: number | undefined;

	box?.addEventListener("click", async () => {
		const text = box.dataset.copy ?? "";
		try {
			await navigator.clipboard.writeText(text);
		} catch {
			// Fallback for browsers without the async clipboard API.
			const ta = document.createElement("textarea");
			ta.value = text;
			ta.style.position = "fixed";
			ta.style.opacity = "0";
			document.body.appendChild(ta);
			ta.select();
			document.execCommand("copy");
			ta.remove();
		}
		if (label) {
			label.textContent = "copied ✓";
			window.clearTimeout(resetTimer);
			resetTimer = window.setTimeout(() => {
				label.textContent = "copy";
			}, 1600);
		}
	});
</script>
