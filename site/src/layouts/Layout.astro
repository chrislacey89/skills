---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Skill Kit — Fifty years of software wisdom, finally executable",
	description = "Skill Kit is a Claude Code skills pack that turns 50 years of software engineering discipline into a delivery pipeline your coding agent follows — shape, build, test, ship. Every skill cites its source.",
} = Astro.props;

// EVERY ICON PATH GOES THROUGH `BASE_URL`. The site is served from a
// project-pages subpath (`/skills`), so a root-absolute `/favicon.ico` resolves
// on `localhost:4321` and 404s in production — and a 404 on an icon is silent,
// because the browser just shows its default.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const favicon = `${base}/favicon.svg`;
// THE .ICO IS THE FALLBACK, NOT THE PRIMARY. The SVG is one 333-byte file that
// stays sharp at any size, and every browser released since 2019 prefers it.
// The `.ico` carries 16/32/48 rasters for the ones that do not — and for the
// clients that never read the markup at all (feed readers, chat unfurlers,
// bookmark managers), which ask the origin for a favicon and take what they get.
const faviconIco = `${base}/favicon.ico`;
const appleTouchIcon = `${base}/apple-touch-icon.png`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og-image.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Set synchronously so scroll-reveal animations only hide content
			// when JS is present to reveal it again.
			document.documentElement.classList.add("has-js");
		</script>
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={faviconIco} />
		<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..600&family=Spectral:ital,wght@0,300;0,400;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
